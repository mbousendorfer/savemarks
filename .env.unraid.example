POSTGRES_DB=savemarks
POSTGRES_USER=savemarks
POSTGRES_PASSWORD=replace-with-a-long-random-password
SAVEMARKS_IMAGE=ghcr.io/mbousendorfer/savemarks:latest
SAVEMARKS_PORT=3210
SAVEMARKS_BASE_URL=http://your-unraid-host:3210
SAVEMARKS_TOKEN_PEPPER=replace-with-a-different-long-random-secret
SAVEMARKS_WEB_USERNAME=savemarks
SAVEMARKS_WEB_PASSWORD=replace-with-a-third-long-random-password
SAVEMARKS_ALLOWED_EXTENSION_IDS=
SAVEMARKS_DEV_ORIGINS=
PUID=99
PGID=100
POSTGRES_DATA_PATH=/mnt/user/appdata/savemarks/postgres
SAVEMARKS_DATA_PATH=/mnt/user/appdata/savemarks/data
