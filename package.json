{
  "name": "savemarks",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "dotenv -e .env -- turbo dev",
    "setup": "npm run env:init && npm run infra:up && npm run db:migrate && npm run extension:build",
    "env:init": "node --experimental-strip-types scripts/init-env.ts",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker-compose.dev.yml down",
    "infra:logs": "docker compose --env-file .env -f infrastructure/docker-compose.dev.yml logs -f postgres",
    "extension:build": "npm run build --workspace=@savemarks/extension",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "fixtures:check": "node --experimental-strip-types scripts/check-fixtures.ts",
    "db:generate": "dotenv -e .env -- npm run generate --workspace=@savemarks/database",
    "db:migrate": "dotenv -e .env -- npm run migrate --workspace=@savemarks/database",
    "check": "npm run typecheck && npm run lint && npm run test && npm run fixtures:check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
