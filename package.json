{
  "name": "savemarks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "dotenv -e .env -- turbo dev",
    "setup": "pnpm env:init && pnpm infra:up && pnpm db:migrate && pnpm extension:build",
    "env:init": "node --experimental-strip-types scripts/init-env.ts",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker-compose.dev.yml down",
    "infra:logs": "docker compose --env-file .env -f infrastructure/docker-compose.dev.yml logs -f postgres",
    "extension:build": "pnpm --filter @savemarks/extension build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "fixtures:check": "node --experimental-strip-types scripts/check-fixtures.ts",
    "db:generate": "dotenv -e .env -- pnpm --filter @savemarks/database generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @savemarks/database migrate",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm fixtures:check && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.10"
  }
}
