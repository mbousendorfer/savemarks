{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "SAVEMARKS_TOKEN_PEPPER",
        "SAVEMARKS_ALLOWED_EXTENSION_IDS",
        "SAVEMARKS_DEV_ORIGINS",
        "SAVEMARKS_BASE_URL",
        "MEDIA_DATA_PATH",
        "BACKUP_DATA_PATH"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
